+     *  pool, and any real swap closes the OLD pool OFF the main thread so the tick never blocks on
+     *  awaitTermination and no queued task is silently dropped (review #1/#3 + async-send review #3). */
+    public static synchronized void configureAsync(final boolean enabled, final int threads, final int queue) {
+        final java.util.concurrent.ThreadPoolExecutor old = asyncPool;
+        final int t = effectiveThreads(threads);
+        final int q = effectiveQueue(threads, queue);
+        if (old != null && enabled && asyncEnabled
+                && old.getCorePoolSize() == t
+                && (old.getQueue().remainingCapacity() + old.getQueue().size()) == q) {
+            return; // no-op reconfigure — don't stall the tick tearing a healthy pool down and back up
+        }
+        if (!enabled) {
+            asyncEnabled = false;
+            asyncPool = null;
+            if (old != null) closePoolOffThread(old);
+            return;
+        }
