+    private static volatile boolean selfTested = false;
+    public static void maybeSelfTest(final net.minecraft.server.MinecraftServer server) {
+        if (selfTested || !Boolean.getBoolean("victus.chunksend.selftest")) {
+            return;
+        }
+        try {
+            net.minecraft.server.level.ServerLevel ow = server.overworld();
+            if (ow == null) {
+                return;
+            }
+            int sx = 0;
+            int sz = 0;
+            try {
+                BlockPos sp = ow.getRespawnData().globalPos().pos();
+                sx = sp.getX() >> 4;
+                sz = sp.getZ() >> 4;
+            } catch (Throwable ignored) {
+                // fall back to chunk 0,0 if the spawn-data API shape differs
+            }
