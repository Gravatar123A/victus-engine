+    /** Byte-equivalence gate: the live ctor and the snapshot ctor MUST produce identical wire bytes (no Anti-Xray). */
+    public static boolean selfTestEquivalent(final LevelChunk chunk) {
+        ClientboundLevelChunkPacketData vanilla = new ClientboundLevelChunkPacketData(chunk, null);
+        ClientboundLevelChunkPacketData snap = fromSnapshot(capture(chunk));
+        return java.util.Arrays.equals(vanilla.buffer, snap.buffer);
+    }
