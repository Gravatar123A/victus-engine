+    // Victus start - async chunk send: main-thread Snapshot + off-thread serialize + byte-equivalence self-test
+    /** Immutable snapshot captured on the MAIN thread; the worker serializes from this only (never the live chunk). */
+    public static final class Snapshot {
+        final Map<Heightmap.Types, long[]> heightmaps;
+        final LevelChunkSection[] sections; // deep copies via LevelChunkSection.copy() — frozen palette
+        final List<ClientboundLevelChunkPacketData.BlockEntityInfo> blockEntities;
+        final List<net.minecraft.network.protocol.Packet<?>> extraPackets;
+        Snapshot(Map<Heightmap.Types, long[]> h, LevelChunkSection[] s,
+                 List<ClientboundLevelChunkPacketData.BlockEntityInfo> be,
+                 List<net.minecraft.network.protocol.Packet<?>> ex) {
+            this.heightmaps = h; this.sections = s; this.blockEntities = be; this.extraPackets = ex;
+        }
+    }
+
+    /** Capture everything the serializer needs, ON THE MAIN THREAD ({@code section.copy()} freezes the palette). */
+    public static Snapshot capture(final LevelChunk levelChunk) {
+        Map<Heightmap.Types, long[]> hm = levelChunk.getHeightmaps()
+            .stream()
+            .filter(e -> ((Heightmap.Types) e.getKey()).sendToClient())
+            .collect(Collectors.toMap(Entry::getKey, e -> (long[]) ((Heightmap) e.getValue()).getRawData().clone()));
+        LevelChunkSection[] live = levelChunk.getSections();
+        LevelChunkSection[] copies = new LevelChunkSection[live.length];
+        for (int i = 0; i < live.length; i++) {
+            copies[i] = live[i].copy();
+        }
+        List<net.minecraft.network.protocol.Packet<?>> extra = new java.util.ArrayList<>();
+        List<ClientboundLevelChunkPacketData.BlockEntityInfo> be = buildBlockEntities(levelChunk, extra);
+        return new Snapshot(hm, copies, be, extra);
+    }
+
+    /** Off-thread entry: build the wire bytes from the frozen Snapshot only. Byte-identical to the live ctor. */
+    public static ClientboundLevelChunkPacketData fromSnapshot(final Snapshot snap) {
+        return new ClientboundLevelChunkPacketData(snap);
+    }
+
+    private ClientboundLevelChunkPacketData(final Snapshot snap) {
+        this.heightmaps = snap.heightmaps;
+        int size = 0;
+        for (LevelChunkSection s : snap.sections) {
+            size += s.getSerializedSize();
+        }
+        this.buffer = new byte[size];
+        FriendlyByteBuf buf = new FriendlyByteBuf(this.getWriteBuffer());
+        int idx = 0;
+        for (LevelChunkSection s : snap.sections) {
+            s.write(buf, null, idx); // v1: no Anti-Xray on the async path (force-sync when shouldModify)
+            idx++;
+        }
+        if (buf.writerIndex() != buf.capacity()) {
+            throw new IllegalStateException("Didn't fill chunk buffer (snapshot): expected "
+                    + buf.capacity() + " bytes, got " + buf.writerIndex());
+        }
+        this.blockEntitiesData = snap.blockEntities;
+        this.extraPackets.addAll(snap.extraPackets);
+    }
