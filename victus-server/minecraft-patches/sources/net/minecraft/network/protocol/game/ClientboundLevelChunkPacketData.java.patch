+            if (data != null) {
+                if (pc.settled.compareAndSet(false, true)) { shell.setChunkData(data); shell.setReady(true); }
+            } else if (pc.settled.compareAndSet(false, true)) {
+                settleOnMain(pc); // serialize threw → guarded main-thread rebuild
+            }
+        });
+    }
