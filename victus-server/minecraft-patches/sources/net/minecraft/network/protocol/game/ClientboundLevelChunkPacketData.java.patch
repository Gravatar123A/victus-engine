+            if (chunk == null) {
+                return; // spawn chunk not loaded yet — retry next tick
+            }
+            selfTested = true;
+            boolean ok = selfTestEquivalent(chunk);
+            org.slf4j.LoggerFactory.getLogger("Victus").info("async chunk send byte-equivalence self-test: "
+                    + (ok ? "PASS (snapshot serializer == vanilla @ chunk " + sx + "," + sz + ")"
+                          : "FAIL — snapshot bytes DIFFER from vanilla @ chunk " + sx + "," + sz));
+        } catch (Throwable t) {
+            selfTested = true;
+            org.slf4j.LoggerFactory.getLogger("Victus").warn("async chunk send self-test error (skipped): " + t);
+        }
+    }
