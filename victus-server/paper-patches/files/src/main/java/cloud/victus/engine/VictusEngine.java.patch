@@ -1,0 +_,310 @@
+// SPDX-License-Identifier: GPL-3.0-only
+package cloud.victus.engine;
+
+import cloud.victus.core.config.ConfigResolver;
+import cloud.victus.core.config.ResolvedConfig;
+import io.papermc.paper.configuration.WorldConfiguration;
+import net.minecraft.world.entity.EntityTypes;
+import net.minecraft.world.entity.MobCategory;
+import org.yaml.snakeyaml.Yaml;
+
+import java.io.BufferedReader;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Map;
+import java.util.logging.Logger;
+
+/**
+ * Native (in-engine) Victus bootstrap. Loads {@code victus.yml} at server startup and resolves it via
+ * victus-core (bundled into the server), so the engine itself — not just a plugin — knows its profile
+ * and settings. Applying those settings to concrete engine behaviour is layered on from here.
+ */
+public final class VictusEngine {
+
+    private static final Logger LOG = Logger.getLogger("Victus");
+    private static final java.util.concurrent.atomic.AtomicBoolean BANNER_PRINTED = new java.util.concurrent.atomic.AtomicBoolean();
+    private static volatile ResolvedConfig config = new ResolvedConfig();
+    /** PARALLEL tick engine (EXPERIMENTAL, opt-in). Non-null + enabled only under threading.mode=parallel. */
+    private static volatile cloud.victus.core.threading.ParallelTickExecutor tickExecutor;
+
+    private VictusEngine() {
+    }
+
+    /** The resolved engine config (never null). */
+    public static ResolvedConfig config() {
+        return config;
+    }
+
+    /**
+     * Logs the native brand only after MinecraftServer has logged its successful Done marker.
+     * The process-wide guard makes reloads and accidental duplicate lifecycle calls harmless.
+     */
+    public static void logStartupBanner() {
+        if (!BANNER_PRINTED.compareAndSet(false, true)) {
+            return;
+        }
+        for (String line : cloud.victus.core.branding.StartupBanner.LINES) {
+            LOG.info(line);
+        }
+    }
+
+    /** Loads victus.yml (writing a documented default if absent) and resolves it. Never throws. */
+    public static void init() {
+        try {
+            Path f = Path.of("victus.yml");
+            Map<String, Object> map = Map.of();
+            if (Files.exists(f)) {
+                try (BufferedReader r = Files.newBufferedReader(f, StandardCharsets.UTF_8)) {
+                    Object parsed = new Yaml().load(r);
+                    if (parsed instanceof Map<?, ?> m) {
+                        @SuppressWarnings("unchecked")
+                        Map<String, Object> cast = (Map<String, Object>) m;
+                        map = cast;
+                    }
+                }
+            } else {
+                Files.writeString(f, cloud.victus.core.config.DefaultConfig.YML, StandardCharsets.UTF_8);
+                LOG.info("wrote a default victus.yml to the server directory");
+            }
+            config = new ConfigResolver(map).resolve(null);
+            LOG.info("engine config: profile=" + config.profile
+                    + " threading=" + config.threadingMode
+                    + " redstone=" + config.redstone
+                    + " compression=" + config.compression
+                    + " dab=" + config.dab
+                    + " max-mspt=" + config.maxMspt);
+            for (String w : config.warnings) {
+                LOG.warning("victus.yml: " + w);
+            }
+            // Push DAB (distance-throttled mob AI) settings into the hot-path statics read by
+            // the patched Mob.serverAiStep(). Safe no-op when optimizations.entities.dab=false.
+            cloud.victus.engine.dab.VictusDab.configure(config);
+            // Hybrid mod bridge (Phase 4 foundation) — isolated + off by default; discovers mods when enabled.
+            VictusHybrid.init(config);
+            // Async chunk send (v1): configure the serializer pool from resolved config (default off).
+            net.minecraft.network.protocol.game.ClientboundLevelChunkPacketData.configureAsync(
+                    config.asyncChunkSend, config.asyncChunkSendThreads, config.asyncChunkSendQueueCapacity);
+            net.minecraft.network.protocol.game.ClientboundLevelChunkPacketData.setWatchdogMs(config.asyncChunkSendWatchdogMs);
+            // PARALLEL tick engine (EXPERIMENTAL — opt-in via threading.mode=parallel). Default SINGLE leaves
+            // the classic serial tick untouched. NOT production-safe yet: world ticks share state (cross-world
+            // entity moves, plugin events on worker threads, static per-world fields) — see docs/phase-4/03.
+            if (config.threadingMode == cloud.victus.core.config.ThreadingMode.PARALLEL) {
+                int tcores = config.nodeCores > 0 ? config.nodeCores : Runtime.getRuntime().availableProcessors();
+                cloud.victus.core.threading.ParallelTickExecutor ex = new cloud.victus.core.threading.ParallelTickExecutor(Math.max(2, Math.min(tcores, 8)));
+                ex.enable();
+                tickExecutor = ex;
+                LOG.warning("threading.mode=parallel — EXPERIMENTAL parallel world ticking ENABLED. Not yet "
+                        + "soak-verified and world-tick thread-safety is incomplete (see docs/phase-4). Test only.");
+            } else if (tickExecutor != null) {
+                tickExecutor.disable();
+                tickExecutor = null;
+            }
+            // Native GC advice — HEAP-AWARE (measured 2026-07-20: Generational ZGC uses ~2x the RAM of
+            // G1 at idle on small/oversold nodes). G1+Aikar is recommended by default; ZGC only pays off
+            // on large, dedicated, many-core heaps where its pause-time win outweighs its RAM/CPU cost.
+            cloud.victus.core.runtime.GcProfile gc = cloud.victus.core.runtime.GcDetector.detect();
+            long heapMb = Runtime.getRuntime().maxMemory() / (1024L * 1024L);
+            boolean largeHeap = heapMb >= cloud.victus.core.runtime.RecommendedFlags.ZGC_MIN_HEAP_MB;
+            if (largeHeap) {
+                if (gc.isGenerationalZgc()) {
+                    LOG.info("GC: running " + gc.displayName() + " (recommended for this large heap)");
+                } else {
+                    LOG.info("GC: running " + gc.displayName() + " on a " + heapMb
+                            + "MB heap — for a heap this large, Generational ZGC (-XX:+UseZGC -XX:+ZGenerational) "
+                            + "can lower pause times; keep G1 if RAM/cores are tight.");
+                }
+            } else {
+                if (gc == cloud.victus.core.runtime.GcProfile.G1) {
+                    LOG.info("GC: running G1 (recommended for a " + heapMb + "MB heap) + add -XX:+UseCompactObjectHeaders for ~15-20% less RAM");
+                } else if (gc.isZgc()) {
+                    LOG.info("GC: running " + gc.displayName() + " on a " + heapMb + "MB heap — G1 uses ~half the RAM "
+                            + "on heaps this size (measured); switch the start flags to G1+Aikar unless you specifically need ZGC pauses.");
+                } else {
+                    LOG.info("GC: running " + gc.displayName());
+                }
+            }
+            // Proactive dedicated-node advisory (mirrors the GC advisory): a big box left on the shared
+            // default leaves chunk worker-threads capped at Moonrise's ~cores/4.
+            int cores = config.nodeCores > 0 ? config.nodeCores : Runtime.getRuntime().availableProcessors();
+            if (!config.dedicated && cores >= 8) {
+                LOG.info("hosting: " + cores + " cores detected but hosting.dedicated=false — set it true on a "
+                        + "DEDICATED node to uncap chunk worker-threads (~2.3x faster chunk gen); keep false on shared hosting.");
+            }
+            // One-line tuning summary so ops/support see every active Victus optimization at a glance.
+            LOG.info("tuning summary: gc=" + gc.displayName() + " heap=" + heapMb + "MB cores=" + cores
+                    + " dedicated=" + config.dedicated + " async-send=" + config.asyncChunkSend
+                    + " dab=" + config.dab + " redstone=" + config.redstone + " compression=" + config.compression);
+        } catch (Throwable t) {
+            // review #2: do NOT reset to hard defaults — a single malformed key on /victus reload would
+            // otherwise silently discard a good running config. Keep the last-good config (on first boot
+            // that is the hard-default ResolvedConfig the static field was initialized with).
+            LOG.warning("failed to load/apply victus.yml; keeping the last-good config (profile="
+                    + config.profile + "): " + t);
+        }
+    }
+
+    /**
+     * Re-reads {@code victus.yml} and re-pushes the runtime-changeable settings (currently DAB) so
+     * {@code /victus reload} and {@code /victus doctor apply} take effect without a JVM restart.
+     * Invoked reflectively by the VictusPlugin reload path (which cannot see this server-internal
+     * class at compile time). Re-applying per-world settings (redstone/spawn caps) still needs a
+     * world reload, but DAB is read live from {@link cloud.victus.engine.dab.VictusDab}'s statics.
+     */
+    public static void reload() {
+        init();
+    }
+
+    // Victus start - dedicated-node chunk auto-tuning. MoonriseCommon.adjustWorkerThreads runs during
+    // global-config load — BEFORE CraftServer constructs and calls init() — so these read victus.yml
+    // directly (once, cached) rather than relying on config()/init() ordering. Never throw.
+    private static volatile int cachedChunkWorkers = Integer.MIN_VALUE;
+    private static volatile int cachedChunkIo = Integer.MIN_VALUE;
+
+    /** Recommended {@code chunk-system.worker-threads} from victus.yml {@code hosting.dedicated} + cores,
+     *  or {@code -1} to keep Moonrise's conservative shared-hosting default. Cached; safe at any phase. */
+    public static int recommendedChunkWorkerThreads(final int detectedCores) {
+        int c = cachedChunkWorkers;
+        if (c != Integer.MIN_VALUE) return c;
+        int result = -1;
+        try {
+            ResolvedConfig cfg = earlyConfig();
+            int cores = cfg.nodeCores > 0 ? cfg.nodeCores : detectedCores;
+            result = cloud.victus.core.runtime.RecommendedFlags.recommendedChunkWorkerThreads(cores, cfg.dedicated);
+            if (result > 0) {
+                LOG.info("dedicated node → chunk-system worker-threads=" + result
+                        + " (uncapped from Moonrise's ~cores/4 shared default; cores=" + cores + ")");
+            }
+        } catch (Throwable ignored) {
+            result = -1;
+        }
+        cachedChunkWorkers = result;
+        return result;
+    }
+
+    /** Recommended {@code chunk-system.io-threads}, or {@code -1} to keep the default (1). */
+    public static int recommendedChunkIoThreads() {
+        int c = cachedChunkIo;
+        if (c != Integer.MIN_VALUE) return c;
+        int result = -1;
+        try {
+            ResolvedConfig cfg = earlyConfig();
+            result = cloud.victus.core.runtime.RecommendedFlags.recommendedChunkIoThreads(cfg.dedicated, cfg.nodeNvme);
+        } catch (Throwable ignored) {
+            result = -1;
+        }
+        cachedChunkIo = result;
+        return result;
+    }
+
+    /** One-off lightweight resolve of victus.yml (independent of init() ordering); falls back to the loaded
+     *  config if the file is absent/unreadable. Never throws. */
+    private static ResolvedConfig earlyConfig() {
+        try {
+            Path f = Path.of("victus.yml");
+            if (Files.exists(f)) {
+                try (BufferedReader r = Files.newBufferedReader(f, StandardCharsets.UTF_8)) {
+                    Object parsed = new Yaml().load(r);
+                    if (parsed instanceof Map<?, ?> m) {
+                        @SuppressWarnings("unchecked")
+                        Map<String, Object> cast = (Map<String, Object>) m;
+                        return new ConfigResolver(cast).resolve(null);
+                    }
+                }
+            }
+        } catch (Throwable ignored) {
+        }
+        return config;
+    }
+
+    /** Observability snapshot for the plugin's Prometheus sampler (invoked reflectively — the plugin
+     *  compiles against the API only and cannot see server internals). Order:
+     *  [asyncEnabled 0/1, asyncDispatched, watchdogFires, chunkWorkerThreads, chunkIoThreads]. Never throws. */
+    public static long[] observabilitySnapshot() {
+        try {
+            boolean on = net.minecraft.network.protocol.game.ClientboundLevelChunkPacketData.asyncEnabled();
+            long dispatched = net.minecraft.network.protocol.game.ClientboundLevelChunkPacketData.asyncDispatchedCount();
+            long fires = net.minecraft.network.protocol.game.ClientboundLevelChunkPacketData.asyncWatchdogFireCount();
+            return new long[]{ on ? 1L : 0L, dispatched, fires,
+                    ca.spottedleaf.moonrise.common.util.MoonriseCommon.victusAppliedWorkerThreads,
+                    ca.spottedleaf.moonrise.common.util.MoonriseCommon.victusAppliedIoThreads };
+        } catch (Throwable t) {
+            return new long[]{0L, 0L, 0L, -1L, -1L};
+        }
+    }
+
+    /** True only under threading.mode=parallel with a live executor — the tick loop takes the parallel path.
+     *  EXPERIMENTAL; default (SINGLE) is always false, so the classic serial tick runs unchanged. */
+    public static boolean parallelWorldTicking() {
+        cloud.victus.core.threading.ParallelTickExecutor ex = tickExecutor;
+        return ex != null && ex.isParallel();
+    }
+
+    /** Tick each level via the parallel executor (barrier-synced; exceptions rethrown on the caller). The
+     *  caller MUST have applied plugin-visible / static per-world state serially first. Falls back to serial
+     *  if the executor is gone. EXPERIMENTAL — see docs/phase-4/03 for the world-tick safety caveats. */
+    public static void tickWorldsParallel(final java.util.List<net.minecraft.server.level.ServerLevel> levels,
+                                          final java.util.function.Consumer<net.minecraft.server.level.ServerLevel> tickFn) {
+        cloud.victus.core.threading.ParallelTickExecutor ex = tickExecutor;
+        java.util.List<Runnable> units = new java.util.ArrayList<>(levels.size());
+        for (final net.minecraft.server.level.ServerLevel level : levels) {
+            units.add(() -> tickFn.accept(level));
+        }
+        if (ex != null) {
+            ex.runAll(units);
+        } else {
+            for (Runnable r : units) r.run();
+        }
+    }
+    // Victus end
+
+    /**
+     * Applies profile-driven optimizations to a freshly-loaded per-world config. Called from
+     * {@code PaperConfigurations.createWorldConfig} for every world, so victus.yml's
+     * {@code optimizations.redstone} (already profile-overlaid in {@link ResolvedConfig}) actually
+     * drives the engine's redstone engine. Never throws.
+     */
+    public static void applyWorldConfig(WorldConfiguration cfg, String worldName) {
+        try {
+            ResolvedConfig c = config;
+            if (c == null || cfg == null || cfg.misc == null) {
+                return;
+            }
+            WorldConfiguration.Misc.RedstoneImplementation target = switch (c.redstone) {
+                case VANILLA -> WorldConfiguration.Misc.RedstoneImplementation.VANILLA;
+                case ALTERNATE_CURRENT -> WorldConfiguration.Misc.RedstoneImplementation.ALTERNATE_CURRENT;
+                case EIGENCRAFT -> WorldConfiguration.Misc.RedstoneImplementation.EIGENCRAFT;
+            };
+            cfg.misc.redstoneImplementation = target;
+
+            // Entities.Spawning — per-player mob spawns + (profile) monster spawn cap
+            String extra = "";
+            if (cfg.entities != null && cfg.entities.spawning != null) {
+                cfg.entities.spawning.perPlayerMobSpawns = c.perPlayerMobSpawns;
+                if (c.monsterSpawnCap >= 0 && cfg.entities.spawning.spawnLimits != null) {
+                    cfg.entities.spawning.spawnLimits.put(MobCategory.MONSTER, c.monsterSpawnCap);
+                    extra = ", monster-spawn-cap=" + c.monsterSpawnCap;
+                }
+            }
+            // Chunks — cap pile-prone projectiles/orbs per chunk (anti-lag; skipped for technical)
+            if (c.projectileSaveLimit >= 0 && cfg.chunks != null && cfg.chunks.entityPerChunkSaveLimit != null) {
+                var limit = cfg.chunks.entityPerChunkSaveLimit;
+                limit.put(EntityTypes.EXPERIENCE_ORB, c.projectileSaveLimit);
+                limit.put(EntityTypes.ARROW, c.projectileSaveLimit);
+                limit.put(EntityTypes.SNOWBALL, c.projectileSaveLimit);
+                limit.put(EntityTypes.ENDER_PEARL, c.projectileSaveLimit);
+                limit.put(EntityTypes.FIREBALL, c.projectileSaveLimit);
+                limit.put(EntityTypes.SMALL_FIREBALL, c.projectileSaveLimit);
+                extra += ", projectile-save-limit=" + c.projectileSaveLimit;
+            }
+
+            LOG.info("applied to world '" + worldName + "' (profile " + c.profile + "): redstone="
+                    + target + ", per-player-mob-spawns=" + c.perPlayerMobSpawns + extra);
+        } catch (Throwable t) {
+            LOG.warning("applyWorldConfig failed for " + worldName + ": " + t);
+        }
+    }
+
+    // The default victus.yml template now lives in cloud.victus.core.config.DefaultConfig — a single owner
+    // shared with VictusPlugin so the two templates cannot drift, and testable in victus-core (review #3/#6).
+}
