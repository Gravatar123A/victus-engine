--- /dev/null
+++ b/src/main/java/cloud/victus/engine/VictusEngine.java
@@ -1,0 +_,165 @@
+// SPDX-License-Identifier: GPL-3.0-only
+package cloud.victus.engine;
+
+import cloud.victus.core.config.ConfigResolver;
+import cloud.victus.core.config.ResolvedConfig;
+import io.papermc.paper.configuration.WorldConfiguration;
+import net.minecraft.world.entity.EntityTypes;
+import net.minecraft.world.entity.MobCategory;
+import org.yaml.snakeyaml.Yaml;
+
+import java.io.BufferedReader;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Map;
+import java.util.logging.Logger;
+
+/**
+ * Native (in-engine) Victus bootstrap. Loads {@code victus.yml} at server startup and resolves it via
+ * victus-core (bundled into the server), so the engine itself — not just a plugin — knows its profile
+ * and settings. Applying those settings to concrete engine behaviour is layered on from here.
+ */
+public final class VictusEngine {
+
+    private static final Logger LOG = Logger.getLogger("Victus");
+    private static volatile ResolvedConfig config = new ResolvedConfig();
+
+    private VictusEngine() {
+    }
+
+    /** The resolved engine config (never null). */
+    public static ResolvedConfig config() {
+        return config;
+    }
+
+    /** Loads victus.yml (writing a documented default if absent) and resolves it. Never throws. */
+    public static void init() {
+        try {
+            Path f = Path.of("victus.yml");
+            Map<String, Object> map = Map.of();
+            if (Files.exists(f)) {
+                try (BufferedReader r = Files.newBufferedReader(f, StandardCharsets.UTF_8)) {
+                    Object parsed = new Yaml().load(r);
+                    if (parsed instanceof Map<?, ?> m) {
+                        @SuppressWarnings("unchecked")
+                        Map<String, Object> cast = (Map<String, Object>) m;
+                        map = cast;
+                    }
+                }
+            } else {
+                Files.writeString(f, DEFAULT_YML, StandardCharsets.UTF_8);
+                LOG.info("wrote a default victus.yml to the server directory");
+            }
+            config = new ConfigResolver(map).resolve(null);
+            LOG.info("engine config: profile=" + config.profile
+                    + " threading=" + config.threadingMode
+                    + " redstone=" + config.redstone
+                    + " compression=" + config.compression
+                    + " dab=" + config.dab
+                    + " max-mspt=" + config.maxMspt);
+            for (String w : config.warnings) {
+                LOG.warning("victus.yml: " + w);
+            }
+            // Push DAB (distance-throttled mob AI) settings into the hot-path statics read by
+            // the patched Mob.serverAiStep(). Safe no-op when optimizations.entities.dab=false.
+            cloud.victus.engine.dab.VictusDab.configure(config);
+            // Native GC advice (victus-core runtime module): nudge toward Generational ZGC.
+            cloud.victus.core.runtime.GcProfile gc = cloud.victus.core.runtime.GcDetector.detect();
+            if (gc.isGenerationalZgc()) {
+                LOG.info("GC: running " + gc.displayName() + " (recommended)");
+            } else {
+                LOG.info("GC: running " + gc.displayName()
+                        + " — for the lowest pause times use -XX:+UseZGC -XX:+ZGenerational (Java 21+)");
+            }
+        } catch (Throwable t) {
+            LOG.warning("failed to load victus.yml (using defaults): " + t);
+            config = new ResolvedConfig();
+        }
+    }
+
+    /**
+     * Re-reads {@code victus.yml} and re-pushes the runtime-changeable settings (currently DAB) so
+     * {@code /victus reload} and {@code /victus doctor apply} take effect without a JVM restart.
+     * Invoked reflectively by the VictusPlugin reload path (which cannot see this server-internal
+     * class at compile time). Re-applying per-world settings (redstone/spawn caps) still needs a
+     * world reload, but DAB is read live from {@link cloud.victus.engine.dab.VictusDab}'s statics.
+     */
+    public static void reload() {
+        init();
+    }
+
+    /**
+     * Applies profile-driven optimizations to a freshly-loaded per-world config. Called from
+     * {@code PaperConfigurations.createWorldConfig} for every world, so victus.yml's
+     * {@code optimizations.redstone} (already profile-overlaid in {@link ResolvedConfig}) actually
+     * drives the engine's redstone engine. Never throws.
+     */
+    public static void applyWorldConfig(WorldConfiguration cfg, String worldName) {
+        try {
+            ResolvedConfig c = config;
+            if (c == null || cfg == null || cfg.misc == null) {
+                return;
+            }
+            WorldConfiguration.Misc.RedstoneImplementation target = switch (c.redstone) {
+                case VANILLA -> WorldConfiguration.Misc.RedstoneImplementation.VANILLA;
+                case ALTERNATE_CURRENT -> WorldConfiguration.Misc.RedstoneImplementation.ALTERNATE_CURRENT;
+                case EIGENCRAFT -> WorldConfiguration.Misc.RedstoneImplementation.EIGENCRAFT;
+            };
+            cfg.misc.redstoneImplementation = target;
+
+            // Entities.Spawning — per-player mob spawns + (profile) monster spawn cap
+            String extra = "";
+            if (cfg.entities != null && cfg.entities.spawning != null) {
+                cfg.entities.spawning.perPlayerMobSpawns = c.perPlayerMobSpawns;
+                if (c.monsterSpawnCap >= 0 && cfg.entities.spawning.spawnLimits != null) {
+                    cfg.entities.spawning.spawnLimits.put(MobCategory.MONSTER, c.monsterSpawnCap);
+                    extra = ", monster-spawn-cap=" + c.monsterSpawnCap;
+                }
+            }
+            // Chunks — cap pile-prone projectiles/orbs per chunk (anti-lag; skipped for technical)
+            if (c.projectileSaveLimit >= 0 && cfg.chunks != null && cfg.chunks.entityPerChunkSaveLimit != null) {
+                var limit = cfg.chunks.entityPerChunkSaveLimit;
+                limit.put(EntityTypes.EXPERIENCE_ORB, c.projectileSaveLimit);
+                limit.put(EntityTypes.ARROW, c.projectileSaveLimit);
+                limit.put(EntityTypes.SNOWBALL, c.projectileSaveLimit);
+                limit.put(EntityTypes.ENDER_PEARL, c.projectileSaveLimit);
+                limit.put(EntityTypes.FIREBALL, c.projectileSaveLimit);
+                limit.put(EntityTypes.SMALL_FIREBALL, c.projectileSaveLimit);
+                extra += ", projectile-save-limit=" + c.projectileSaveLimit;
+            }
+
+            LOG.info("applied to world '" + worldName + "' (profile " + c.profile + "): redstone="
+                    + target + ", per-player-mob-spawns=" + c.perPlayerMobSpawns + extra);
+        } catch (Throwable t) {
+            LOG.warning("applyWorldConfig failed for " + worldName + ": " + t);
+        }
+    }
+
+    private static final String DEFAULT_YML = ""
+            + "# Victus Engine config. See docs/VICTUS-CONFIG.md for the full schema.\n"
+            + "engine:\n"
+            + "  profile: smp            # smp | technical | minigames | modded | network\n"
+            + "threading:\n"
+            + "  mode: single            # single | parallel | regionized\n"
+            + "optimizations:\n"
+            + "  # These are left commented so the chosen 'profile' decides them. Uncomment to force a\n"
+            + "  # value regardless of profile (e.g. technical wants vanilla redstone + dab off).\n"
+            + "  #redstone: alternate-current   # vanilla | alternate-current | eigencraft\n"
+            + "  entities:\n"
+            + "    #dab: true                   # distance-throttle far mob AI (profile decides if unset)\n"
+            + "    #dab-start-distance: 12      # blocks within which mobs always full-tick AI\n"
+            + "    #dab-max-tick-interval: 20   # a far mob ticks AI at most once every N ticks\n"
+            + "    async-pathfinding: true\n"
+            + "    per-player-mob-spawns: true\n"
+            + "  network:\n"
+            + "    compression: libdeflate     # zlib | libdeflate (NOT zstd — breaks clients)\n"
+            + "hosting:\n"
+            + "  limits:\n"
+            + "    max-mspt: 45\n"
+            + "  metrics:\n"
+            + "    prometheus:\n"
+            + "      enabled: true\n"
+            + "      bind: 127.0.0.1\n"
+            + "      port: 9940\n";
+}
