+// SPDX-License-Identifier: GPL-3.0-only
+package cloud.victus.engine;
+
+import cloud.victus.core.config.ResolvedConfig;
+
+import java.io.File;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.logging.Logger;
+import java.util.zip.ZipFile;
+
+/**
+ * Late hybrid discovery diagnostics retained for migration only.
+ *
+ * @deprecated A loader cannot be initialized safely after Paper/Minecraft classes are live. The old direct
+ * entrypoint invoker has been removed. Use {@code cloud.victus.hybrid.launcher.VictusHybridLauncher} as the
+ * process main so the disabled/fabric/neoforge choice and transformations happen before the server main.
+ */
+@Deprecated(forRemoval = true)
+public final class VictusHybrid {
+
+    private static final Logger LOG = Logger.getLogger("Victus");
+
+    private VictusHybrid() {
+    }
+    /** Discovery only: never loads a mod class and never claims runtime support. */
+    public static void diagnose(final ResolvedConfig config) {
+        if (config == null || !config.hybridEnabled) {
+            return;
+        }
+        final File modsDir = new File("mods");
+        int fabric = 0;
+        int neoforge = 0;
+        int unknown = 0;
+        final List<String> names = new ArrayList<>();
+        final File[] jars = modsDir.isDirectory()
+                ? modsDir.listFiles((directory, name) -> name.toLowerCase(java.util.Locale.ROOT).endsWith(".jar"))
+                : null;
+        if (jars != null) {
+            for (final File jar : jars) {
+                switch (classify(jar)) {
+                    case "fabric" -> fabric++;
+                    case "neoforge" -> neoforge++;
+                    default -> unknown++;
+                }
+                names.add(jar.getName());
+            }
+        }
+        LOG.severe("hybrid.enabled in victus.yml is diagnostics-only and cannot start a loader this late. "
+                + "No mod code was invoked. Restart through VictusHybridLauncher with an explicit fabric or "
+                + "neoforge profile after satisfying its locked preflight. Discovered [fabric=" + fabric
+                + " neoforge=" + neoforge + " unknown=" + unknown + "].");
+        if (!names.isEmpty()) {
+            LOG.info("hybrid discovery only: " + String.join(", ", names));
+        }
+    }
+
+    private static String classify(final File jar) {
+        try (ZipFile zip = new ZipFile(jar)) {
+            if (zip.getEntry("fabric.mod.json") != null) {
+                return "fabric";
+            }
+            if (zip.getEntry("META-INF/neoforge.mods.toml") != null
+                    || zip.getEntry("META-INF/mods.toml") != null) {
+                return "neoforge";
+            }
+        } catch (Throwable ignored) {
+            // Broken/foreign jars remain visible as unknown diagnostics.
+        }
+        return "unknown";
+    }
+}
